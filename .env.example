# Plato environment — see docs/architecture.md §23
# Copy to .env.local and fill in real values. .env* is gitignored; never commit secrets.

# --- Site ---
# The canonical public root. Lock this once the .io vs .online domain is decided.
NEXT_PUBLIC_SITE_URL=https://platodigital.io

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bunny Stream (video) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=

# --- Resend (email) ---
RESEND_API_KEY=
# The verified sending address, e.g. hello@platodigital.io
RESEND_FROM_EMAIL=

# --- Billing ---
# Shown on invoices. Bank details TBD until the Aruba Bank account opens.
INVOICE_PAYMENT_INSTRUCTIONS=
# Protects the scheduled crons (reminders, analytics rollup). Any long random string.
CRON_SECRET=
# Salt for the cookieless analytics session hash. Any random string.
ANALYTICS_SALT=

# --- Claude API (menu translation + photo-menu OCR) ---
ANTHROPIC_API_KEY=

# --- Stripe (dormant — card path not enabled at launch, Sentoo later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Where /book demo requests are emailed (default: adrian@platodigital.online)
BOOKING_TO=

# --- Sentry (error monitoring) ---
# Public DSN from Sentry → Project Settings → Client Keys (DSN). Safe to expose; add to
# .env.local AND Vercel. Without it, Sentry no-ops (and it only sends in production).
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload (set in Vercel / CI env, not required for the app to run).
# SENTRY_AUTH_TOKEN is a SECRET — add it only in Vercel, never commit it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
